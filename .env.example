# ============================================================
# SKY STANDARD 公式LINE — 設定キー一覧（値は絶対にコミットしない）
# ============================================================

# ---- 署名検証リレー（Cloud Run の環境変数 / Secret Manager） ----
LINE_CHANNEL_SECRET=
RELAY_SHARED_SECRET=
GAS_WEBAPP_URL=

# ---- GAS スクリプトプロパティ（GAS エディタ > プロジェクトの設定 > スクリプト プロパティ） ----
# LINE_CHANNEL_ACCESS_TOKEN=     Messaging API チャネルアクセストークン（長期）
# LINE_CHANNEL_SECRET=           （任意・参照用。署名検証はリレーで実施）
# RELAY_SHARED_SECRET=           リレーと同じ値（32文字以上のランダム文字列）
# RESERVATION_WEBHOOK_SECRET=    予約サイト → GAS の予約イベント署名用シークレット
# RESERVATION_API_KEY=           予約サイト API の Bearer キー
# RESERVATION_API_ALLOWED_HOST=  API キーを送ってよいホスト名（ID管理の URL と一致した場合のみ送信）
# ADMIN_EMAIL=                   （任意）運営通知メール送信先
# SPREADSHEET_ID=                起動用（管理メニューのシート補完で自動設定）
# ADMIN_USERS=                   管理メニューを操作できるメールアドレス（カンマ区切り）
# ALLOW_UNSIGNED_WEBHOOK=        開発時のみ true。本番では設定しない

# ---- 公開可能な ID・URL（スプレッドシート「ID管理」シート B列で管理。コードに書かない） ----
# LINE_LOGIN_CHANNEL_ID / LIFF_ID / GAS_WEBAPP_URL / BOOKING_SITE_URL / BOOKING_CONFIRM_URL / PLAN_LIST_URL
# CHARTER_URL / ADMIN_NOTIFY_TARGET / RICHMENU_IMAGE_FILE_ID / RESERVATION_API_BASE_URL / SPREADSHEET_ID / GAS_SCRIPT_ID

# ---- 予約確認画面（src/web/booking/config.json。公開値のみ） ----
# { "liffId": "", "apiUrl": "<GAS_WEBAPP_URL>" }
